<script>

    /* =====================================================
       DATA
    ===================================================== */

    let collections = [];


    /* =====================================================
       PAGE NAVIGATION
    ===================================================== */

    function showPage(pageId, button) {

        document
            .querySelectorAll(".page")
            .forEach(page => {

                page.classList.remove("active");

            });


        document
            .getElementById(pageId)
            .classList.add("active");


        document
            .querySelectorAll(".nav-item")
            .forEach(item => {

                item.classList.remove("active");

            });


        button.classList.add("active");


        const titles = {

            collector: [
                "Collector Dashboard",
                "Record and track your e-waste collections"
            ],

            aggregator: [
                "Aggregator Dashboard",
                "Verify incoming collection records"
            ],

            recycler: [
                "Recycler Portal",
                "Confirm received e-waste material"
            ],

            brand: [
                "Brand / PRO Dashboard",
                "Monitor EPR compliance and fulfillment"
            ]

        };


        document
            .getElementById("pageTitle")
            .textContent =
            titles[pageId][0];


        document
            .getElementById("pageSubtitle")
            .textContent =
            titles[pageId][1];

    }


    /* =====================================================
       CONNECTION STATUS
    ===================================================== */

    function updateConnection() {

        const text =
            document.getElementById(
                "connectionText"
            );


        const sync =
            document.getElementById(
                "syncStatus"
            );


        if (navigator.onLine) {

            text.textContent =
                "Online";

            sync.textContent =
                "Online";

        } else {

            text.textContent =
                "Offline";

            sync.textContent =
                "Offline";

        }

    }


    updateConnection();


    window.addEventListener(
        "online",
        updateConnection
    );


    window.addEventListener(
        "offline",
        updateConnection
    );


    /* =====================================================
       TOAST
    ===================================================== */

    function showToast(message) {

        const toast =
            document.getElementById("toast");


        toast.textContent = message;

        toast.classList.add("show");


        setTimeout(() => {

            toast.classList.remove("show");

        }, 3000);

    }


    /* =====================================================
       GPS
    ===================================================== */

    function getLocation() {

        if (!navigator.geolocation) {

            showToast(
                "GPS is not supported by this browser."
            );

            return;
        }


        showToast(
            "📍 Capturing location..."
        );


        navigator.geolocation.getCurrentPosition(

            function(position) {

                const lat =
                    position.coords.latitude
                    .toFixed(6);

                const lng =
                    position.coords.longitude
                    .toFixed(6);


                document
                    .getElementById("location")
                    .value =
                    `${lat}, ${lng}`;


                showToast(
                    "📍 GPS location captured!"
                );

            },


            function() {

                showToast(
                    "Unable to capture GPS location."
                );

            }

        );

    }


    /* =====================================================
       PHOTO
    ===================================================== */

    document
        .getElementById("photo")
        .addEventListener(
            "change",
            function() {

                if (this.files.length > 0) {

                    document
                        .getElementById("photoName")
                        .textContent =
                        "📸 " +
                        this.files[0].name;

                }

            }
        );


    /* =====================================================
       COLLECTION FORM
    ===================================================== */

    document
        .getElementById("collectionForm")
        .addEventListener(
            "submit",
            function(event) {

                event.preventDefault();


                const collectorId =
                    document
                        .getElementById("collectorId")
                        .value;


                const itemType =
                    document
                        .getElementById("itemType")
                        .value;


                const quantity =
                    Number(
                        document
                            .getElementById("quantity")
                            .value
                    );


                const weight =
                    Number(
                        document
                            .getElementById("weight")
                            .value
                    );


                const location =
                    document
                        .getElementById("location")
                        .value;


                const collectionId =
                    "EW-" +
                    Date.now();


                const collection = {

                    collection_id:
                        collectionId,

                    collector_id:
                        collectorId,

                    item_type:
                        itemType,

                    quantity:
                        quantity,

                    collector_weight:
                        weight,

                    aggregator_weight:
                        null,

                    recycler_weight:
                        null,

                    location:
                        location,

                    timestamp:
                        new Date()
                        .toISOString(),

                    status:
                        "SUBMITTED",

                    epr_verified:
                        false,

                    reward_points:
                        0

                };


                collections.push(
                    collection
                );


                updateDashboards();


                showToast(
                    "✅ Collection recorded successfully!"
                );


                this.reset();


                document
                    .getElementById("location")
                    .value = "";

            }
        );


    /* =====================================================
       UPDATE DASHBOARDS
    ===================================================== */

    function updateDashboards() {

        let totalWeight = 0;

        let verifiedWeight = 0;

        let pending = 0;

        let verified = 0;

        let flagged = 0;

        let points = 0;


        collections.forEach(
            item => {

                totalWeight +=
                    item.collector_weight;


                points +=
                    item.reward_points;


                if (item.epr_verified) {

                    verifiedWeight +=
                        item.recycler_weight;

                    verified++;

                } else if (
                    item.status === "FLAGGED"
                ) {

                    flagged++;

                } else {

                    pending++;

                }

            }
        );


        /* Collector */

        document
            .getElementById("totalCollections")
            .textContent =
            collections.length;


        document
            .getElementById("totalWeight")
            .textContent =
            totalWeight.toFixed(2) +
            " kg";


        document
            .getElementById("rewardPoints")
            .textContent =
            points;


        /* Aggregator */

        document
            .getElementById("pendingCount")
            .textContent =
            pending;


        document
            .getElementById("aggregatorWeight")
            .textContent =
            totalWeight.toFixed(2) +
            " kg";


        document
            .getElementById("verifiedCount")
            .textContent =
            verified;


        document
            .getElementById("flaggedCount")
            .textContent =
            flagged;


        /* Brand */

        const obligation = 10000;


        const remaining =
            Math.max(
                obligation -
                verifiedWeight,
                0
            );


        const compliance =
            Math.min(
                (verifiedWeight /
                obligation) * 100,
                100
            );


        document
            .getElementById(
                "brandFulfillment"
            )
            .textContent =
            verifiedWeight.toFixed(2) +
            " kg";


        document
            .getElementById(
                "brandRemaining"
            )
            .textContent =
            remaining.toFixed(2) +
            " kg";


        document
            .getElementById(
                "compliance"
            )
            .textContent =
            compliance.toFixed(1) +
            "%";


        document
            .getElementById(
                "informalWeight"
            )
            .textContent =
            verifiedWeight.toFixed(2) +
            " kg";


        document
            .getElementById(
                "progressText"
            )
            .textContent =
            compliance.toFixed(1) +
            "%";


        document
            .getElementById(
                "circleValue"
            )
            .textContent =
            compliance.toFixed(1) +
            "%";


        document
            .getElementById(
                "progressBar"
            )
            .style.width =
            compliance + "%";


        document
            .getElementById(
                "complianceCircle"
            )
            .style.background =
            `conic-gradient(
                #22c55e
                ${compliance * 3.6}deg,
                #182231
                0deg
            )`;


        updateCollectorTable();

        updateAggregatorTable();

        updateBrandTable();

        updateActivity();

    }


    /* =====================================================
       COLLECTOR TABLE
    ===================================================== */

    function updateCollectorTable() {

        const table =
            document
                .getElementById(
                    "collectorTable"
                );


        if (collections.length === 0) {

            table.innerHTML = `
                <tr>
                    <td colspan="5"
                        style="text-align:center;color:#64748b;">
                        No collections recorded yet
                    </td>
                </tr>
            `;

            return;
        }


        table.innerHTML = "";


        collections
            .slice()
            .reverse()
            .forEach(item => {

                const statusClass =
                    item.epr_verified
                    ? "badge-green"
                    : "badge-orange";


                const statusText =
                    item.epr_verified
                    ? "EPR VERIFIED"
                    : item.status;


                table.innerHTML += `

                    <tr>

                        <td>
                            ${item.collection_id}
                        </td>

                        <td>
                            ${item.item_type}
                        </td>

                        <td>
                            ${item.collector_weight}
                            kg
                        </td>

                        <td>
                            ${new Date(
                                item.timestamp
                            ).toLocaleTimeString()}
                        </td>

                        <td>

                            <span
                                class="badge ${statusClass}"
                            >
                                ${statusText}
                            </span>

                        </td>

                    </tr>

                `;

            });

    }


    /* =====================================================
       AGGREGATOR TABLE
    ===================================================== */

    function updateAggregatorTable() {

        const table =
            document
                .getElementById(
                    "aggregatorTable"
                );


        if (collections.length === 0) {

            table.innerHTML = `
                <tr>
                    <td colspan="5"
                        style="text-align:center;color:#64748b;">
                        No collections available
                    </td>
                </tr>
            `;

            return;
        }


        table.innerHTML = "";


        collections.forEach(item => {

            table.innerHTML += `

                <tr>

                    <td>
                        ${item.collection_id}
                    </td>

                    <td>
                        ${item.collector_id}
                    </td>

                    <td>
                        ${item.item_type}
                    </td>

                    <td>
                        ${item.collector_weight}
                        kg
                    </td>

                    <td>

                        <span
                            class="badge badge-orange"
                        >
                            ${item.status}
                        </span>

                    </td>

                </tr>

            `;

        });

    }


    /* =====================================================
       BRAND TABLE
    ===================================================== */

    function updateBrandTable() {

        const table =
            document
                .getElementById(
                    "brandTable"
                );


        const verified =
            collections.filter(
                item =>
                    item.epr_verified
            );


        if (verified.length === 0) {

            table.innerHTML = `
                <tr>
                    <td colspan="4"
                        style="text-align:center;color:#64748b;">
                        No verified collections yet
                    </td>
                </tr>
            `;

            return;
        }


        table.innerHTML = "";


        verified.forEach(item => {

            table.innerHTML += `

                <tr>

                    <td>
                        ${item.collection_id}
                    </td>

                    <td>
                        Informal Channel
                    </td>

                    <td>
                        ${item.recycler_weight}
                        kg
                    </td>

                    <td>

                        <span
                            class="badge badge-green"
                        >
                            VERIFIED
                        </span>

                    </td>

                </tr>

            `;

        });

    }


    /* =====================================================
       ACTIVITY
    ===================================================== */

    function updateActivity() {

        const activity =
            document
                .getElementById(
                    "activityList"
                );


        if (collections.length === 0) {

            return;
        }


        activity.innerHTML = "";


        collections
            .slice()
            .reverse()
            .slice(0, 4)
            .forEach(item => {

                activity.innerHTML += `

                    <div class="activity">

                        <div class="activity-icon">
                            📦
                        </div>

                        <div class="activity-text">

                            <strong>
                                ${item.item_type}
                                collected
                            </strong>

                            <p>
                                ${item.collector_weight}
                                kg ·
                                ${item.collection_id}
                            </p>

                        </div>

                        <span class="badge badge-green">
                            LOGGED
                        </span>

                    </div>

                `;

            });

    }


    /* =====================================================
       RECYCLER CONFIRMATION
    ===================================================== */

    function confirmRecycler() {

        const id =
            document
                .getElementById(
                    "recyclerCollectionId"
                )
                .value
                .trim();


        const weight =
            Number(
                document
                    .getElementById(
                        "recyclerWeight"
                    )
                    .value
            );


        const collection =
            collections.find(
                item =>
                    item.collection_id === id
            );


        if (!collection) {

            showToast(
                "❌ Collection ID not found."
            );

            return;
        }


        if (!weight || weight <= 0) {

            showToast(
                "❌ Enter a valid received weight."
            );

            return;
        }


        collection.recycler_weight =
            weight;


        collection.epr_verified =
            true;


        collection.status =
            "EPR_VERIFIED";


        collection.reward_points =
            Math.floor(
                weight * 10
            );


        updateDashboards();


        showToast(
            "🧾 EPR verification completed!"
        );

    }

