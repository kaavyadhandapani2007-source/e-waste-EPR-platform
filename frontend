<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>EcoTrace — E-Waste EPR Platform</title>

    <style>

        /* =====================================================
           GLOBAL
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #070b12;
            --sidebar: #0b111b;
            --card: #101722;
            --card-hover: #141d2a;
            --border: #1d2938;

            --text: #f8fafc;
            --muted: #7f8da3;

            --green: #22c55e;
            --green-dark: #15803d;
            --cyan: #06b6d4;
            --blue: #3b82f6;
            --orange: #f59e0b;
            --red: #ef4444;

            --radius: 18px;
        }

        body {

            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            background:
                radial-gradient(
                    circle at 80% 10%,
                    rgba(34,197,94,0.08),
                    transparent 25%
                ),
                var(--bg);

            color: var(--text);

            min-height: 100vh;

            overflow-x: hidden;
        }

        button,
        input,
        select {
            font-family: inherit;
        }

        button {
            cursor: pointer;
        }


        /* =====================================================
           LAYOUT
        ===================================================== */

        .app {

            display: flex;

            min-height: 100vh;
        }


        /* =====================================================
           SIDEBAR
        ===================================================== */

        .sidebar {

            width: 250px;

            background:
                rgba(11,17,27,0.92);

            border-right:
                1px solid var(--border);

            padding: 25px 16px;

            position: fixed;

            left: 0;
            top: 0;
            bottom: 0;

            z-index: 100;

            backdrop-filter: blur(20px);
        }


        .brand {

            display: flex;

            align-items: center;

            gap: 12px;

            padding: 5px 10px 30px;
        }


        .brand-logo {

            width: 40px;
            height: 40px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background:
                linear-gradient(
                    135deg,
                    #22c55e,
                    #06b6d4
                );

            font-size: 20px;

            box-shadow:
                0 0 25px
                rgba(34,197,94,0.25);
        }


        .brand-name {

            font-size: 19px;

            font-weight: 800;
        }


        .brand-name span {

            color: var(--green);
        }


        .nav-label {

            color: #536176;

            font-size: 10px;

            font-weight: 700;

            letter-spacing: 1.4px;

            padding: 0 12px;

            margin-bottom: 10px;
        }


        .nav-item {

            width: 100%;

            display: flex;

            align-items: center;

            gap: 13px;

            padding: 12px;

            margin-bottom: 5px;

            border-radius: 11px;

            background: transparent;

            border: none;

            color: var(--muted);

            text-align: left;

            transition: 0.2s;
        }


        .nav-item:hover {

            background: #121c29;

            color: white;
        }


        .nav-item.active {

            background:
                linear-gradient(
                    90deg,
                    rgba(34,197,94,0.15),
                    rgba(34,197,94,0.04)
                );

            color: #4ade80;

            border-left:
                2px solid var(--green);
        }


        .nav-icon {

            width: 20px;

            text-align: center;
        }


        .sidebar-bottom {

            position: absolute;

            bottom: 20px;

            left: 16px;
            right: 16px;
        }


        .system-status {

            padding: 14px;

            border:
                1px solid var(--border);

            border-radius: 14px;

            background: #0d1520;
        }


        .status-title {

            font-size: 12px;

            color: var(--muted);

            margin-bottom: 8px;
        }


        .status-online {

            display: flex;

            align-items: center;

            gap: 7px;

            font-size: 12px;

            color: #4ade80;
        }


        .dot {

            width: 7px;
            height: 7px;

            border-radius: 50%;

            background: var(--green);

            box-shadow:
                0 0 8px
                rgba(34,197,94,0.8);
        }


        /* =====================================================
           MAIN
        ===================================================== */

        .main {

            margin-left: 250px;

            width: calc(100% - 250px);

            min-height: 100vh;

            padding: 25px 30px;
        }


        .topbar {

            display: flex;

            align-items: center;

            justify-content: space-between;

            margin-bottom: 30px;
        }


        .page-title h1 {

            font-size: 26px;

            margin-bottom: 5px;
        }


        .page-title p {

            color: var(--muted);

            font-size: 13px;
        }


        .top-actions {

            display: flex;

            align-items: center;

            gap: 12px;
        }


        .connection {

            display: flex;

            align-items: center;

            gap: 8px;

            padding: 9px 13px;

            background: #0d1715;

            border:
                1px solid #17452c;

            border-radius: 30px;

            font-size: 12px;

            color: #4ade80;
        }


        .avatar {

            width: 38px;
            height: 38px;

            border-radius: 12px;

            background:
                linear-gradient(
                    135deg,
                    #334155,
                    #1e293b
                );

            display: flex;

            align-items: center;

            justify-content: center;

            font-weight: 700;
        }


        /* =====================================================
           PAGE
        ===================================================== */

        .page {

            display: none;

            animation: fadeIn 0.25s ease;
        }


        .page.active {

            display: block;
        }


        @keyframes fadeIn {

            from {
                opacity: 0;
                transform: translateY(5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        /* =====================================================
           STATS
        ===================================================== */

        .stats-grid {

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 16px;

            margin-bottom: 20px;
        }


        .stat-card {

            background:
                linear-gradient(
                    145deg,
                    #111a26,
                    #0d141e
                );

            border:
                1px solid var(--border);

            border-radius:
                var(--radius);

            padding: 20px;

            transition: 0.2s;
        }


        .stat-card:hover {

            transform: translateY(-2px);

            border-color: #2a3a4f;
        }


        .stat-top {

            display: flex;

            align-items: center;

            justify-content: space-between;

            margin-bottom: 16px;
        }


        .stat-label {

            font-size: 12px;

            color: var(--muted);
        }


        .stat-icon {

            width: 35px;
            height: 35px;

            border-radius: 10px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #172232;

            font-size: 16px;
        }


        .stat-value {

            font-size: 26px;

            font-weight: 800;

            margin-bottom: 7px;
        }


        .stat-change {

            font-size: 11px;

            color: #4ade80;
        }


        /* =====================================================
           GRID
        ===================================================== */

        .grid-2 {

            display: grid;

            grid-template-columns:
                1.5fr 1fr;

            gap: 20px;

            margin-bottom: 20px;
        }


        .card {

            background:
                rgba(16,23,34,0.88);

            border:
                1px solid var(--border);

            border-radius:
                var(--radius);

            padding: 22px;
        }


        .card-header {

            display: flex;

            align-items: center;

            justify-content: space-between;

            margin-bottom: 20px;
        }


        .card-title {

            font-size: 15px;

            font-weight: 700;
        }


        .card-subtitle {

            color: var(--muted);

            font-size: 11px;

            margin-top: 4px;
        }


        /* =====================================================
           FORM
        ===================================================== */

        .form-grid {

            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 15px;
        }


        .form-group {

            display: flex;

            flex-direction: column;

            gap: 7px;
        }


        .form-group.full {

            grid-column: 1 / -1;
        }


        label {

            font-size: 11px;

            color: #aab6c7;

            font-weight: 600;
        }


        input,
        select {

            width: 100%;

            padding: 12px 13px;

            background: #0a111b;

            border:
                1px solid #253346;

            border-radius: 10px;

            color: white;

            outline: none;

            font-size: 13px;

            transition: 0.2s;
        }


        input:focus,
        select:focus {

            border-color:
                var(--green);

            box-shadow:
                0 0 0 3px
                rgba(34,197,94,0.08);
        }


        select option {

            background: #111827;
        }


        .input-with-button {

            display: flex;

            gap: 8px;
        }


        .small-btn {

            border:
                1px solid #29405a;

            background: #111d2b;

            color: #cbd5e1;

            border-radius: 9px;

            padding: 0 14px;

            font-size: 12px;

            white-space: nowrap;
        }


        .small-btn:hover {

            background: #182638;
        }


        .submit-btn {

            width: 100%;

            padding: 14px;

            border: none;

            border-radius: 11px;

            background:
                linear-gradient(
                    135deg,
                    #22c55e,
                    #16a34a
                );

            color: white;

            font-size: 13px;

            font-weight: 800;

            margin-top: 18px;

            box-shadow:
                0 8px 25px
                rgba(34,197,94,0.16);

            transition: 0.2s;
        }


        .submit-btn:hover {

            transform: translateY(-1px);

            box-shadow:
                0 12px 30px
                rgba(34,197,94,0.25);
        }


        /* =====================================================
           PHOTO
        ===================================================== */

        .photo-upload {

            border:
                1px dashed #33465d;

            border-radius: 12px;

            padding: 18px;

            text-align: center;

            background: #0b131e;
        }


        .photo-upload-icon {

            font-size: 28px;

            margin-bottom: 7px;
        }


        .photo-upload p {

            color: var(--muted);

            font-size: 11px;

            margin-bottom: 10px;
        }


        .file-btn {

            display: inline-block;

            padding: 8px 13px;

            border-radius: 8px;

            background: #162334;

            border: 1px solid #29405a;

            font-size: 11px;

            cursor: pointer;
        }


        #photo {

            display: none;
        }


        /* =====================================================
           TABLE
        ===================================================== */

        .table-wrap {

            overflow-x: auto;
        }


        table {

            width: 100%;

            border-collapse: collapse;

            font-size: 12px;
        }


        th {

            text-align: left;

            color: #66758a;

            font-size: 10px;

            text-transform: uppercase;

            letter-spacing: 0.7px;

            padding:
                11px 10px;

            border-bottom:
                1px solid var(--border);
        }


        td {

            padding:
                14px 10px;

            border-bottom:
                1px solid #172231;

            color: #cbd5e1;
        }


        tr:hover td {

            background: #101b28;
        }


        .badge {

            display: inline-flex;

            align-items: center;

            padding: 5px 9px;

            border-radius: 20px;

            font-size: 9px;

            font-weight: 700;
        }


        .badge-green {

            color: #4ade80;

            background: #0d2a1a;
        }


        .badge-orange {

            color: #fbbf24;

            background: #2b200c;
        }


        .badge-blue {

            color: #38bdf8;

            background: #092533;
        }


        .badge-red {

            color: #f87171;

            background: #2a1012;
        }


        /* =====================================================
           PROGRESS
        ===================================================== */

        .progress-container {

            margin-top: 15px;
        }


        .progress-info {

            display: flex;

            justify-content: space-between;

            font-size: 11px;

            color: var(--muted);

            margin-bottom: 8px;
        }


        .progress {

            height: 8px;

            background: #182231;

            border-radius: 20px;

            overflow: hidden;
        }


        .progress-bar {

            height: 100%;

            width: 72.4%;

            background:
                linear-gradient(
                    90deg,
                    #22c55e,
                    #06b6d4
                );

            border-radius: inherit;
        }


        /* =====================================================
           ACTIVITY
        ===================================================== */

        .activity {

            display: flex;

            gap: 12px;

            padding: 12px 0;

            border-bottom:
                1px solid #172231;
        }


        .activity:last-child {

            border-bottom: none;
        }


        .activity-icon {

            width: 32px;
            height: 32px;

            border-radius: 9px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #172334;
        }


        .activity-text {

            flex: 1;
        }


        .activity-text strong {

            font-size: 11px;
        }


        .activity-text p {

            color: var(--muted);

            font-size: 10px;

            margin-top: 3px;
        }


        /* =====================================================
           TOAST
        ===================================================== */

        .toast {

            position: fixed;

            right: 25px;

            bottom: 25px;

            padding: 14px 18px;

            background: #132019;

            border:
                1px solid #245d39;

            border-radius: 12px;

            color: #86efac;

            font-size: 12px;

            transform:
                translateY(100px);

            opacity: 0;

            transition: 0.3s;

            z-index: 1000;
        }


        .toast.show {

            transform:
                translateY(0);

            opacity: 1;
        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 900px) {

            .sidebar {

                width: 70px;

                padding: 20px 10px;
            }

            .brand-name,
            .nav-label,
            .nav-item span,
            .system-status {

                display: none;
            }

            .brand {

                justify-content: center;
            }

            .nav-item {

                justify-content: center;
            }

            .main {

                margin-left: 70px;

                width:
                    calc(100% - 70px);
            }

            .stats-grid {

                grid-template-columns:
                    repeat(2, 1fr);
            }

            .grid-2 {

                grid-template-columns: 1fr;
            }
        }


        @media (max-width: 600px) {

            .main {

                padding: 18px 14px;
            }

            .topbar {

                align-items: flex-start;
            }

            .connection {

                display: none;
            }

            .stats-grid {

                grid-template-columns: 1fr 1fr;
            }

            .stat-value {

                font-size: 20px;
            }

            .form-grid {

                grid-template-columns: 1fr;
            }

            .form-group.full {

                grid-column: auto;
            }

            .card {

                padding: 17px;
            }
        }

    </style>

</head>


<body>


<div class="app">


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-logo">
                ♻️
            </div>

            <div class="brand-name">
                Eco<span>Trace</span>
            </div>

        </div>


        <div class="nav-label">
            PLATFORM
        </div>


        <button
            class="nav-item active"
            onclick="showPage('collector', this)"
        >

            <div class="nav-icon">📱</div>

            <span>Collector</span>

        </button>


        <button
            class="nav-item"
            onclick="showPage('aggregator', this)"
        >

            <div class="nav-icon">🏭</div>

            <span>Aggregator</span>

        </button>


        <button
            class="nav-item"
            onclick="showPage('recycler', this)"
        >

            <div class="nav-icon">♻️</div>

            <span>Recycler</span>

        </button>


        <button
            class="nav-item"
            onclick="showPage('brand', this)"
        >

            <div class="nav-icon">🏢</div>

            <span>Brand / PRO</span>

        </button>


        <div class="sidebar-bottom">

            <div class="system-status">

                <div class="status-title">
                    SYSTEM STATUS
                </div>

                <div class="status-online">

                    <div class="dot"></div>

                    All systems operational

                </div>

            </div>

        </div>

    </aside>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="main">


        <div class="topbar">

            <div class="page-title">

                <h1 id="pageTitle">
                    Collector Dashboard
                </h1>

                <p id="pageSubtitle">
                    Record and track your e-waste collections
                </p>

            </div>


            <div class="top-actions">

                <div class="connection">

                    <div class="dot"></div>

                    <span id="connectionText">
                        Online
                    </span>

                </div>


                <div class="avatar">
                    C
                </div>

            </div>

        </div>


        <!-- =================================================
             COLLECTOR
        ================================================== -->

        <section
            id="collector"
            class="page active"
        >


            <div class="stats-grid">


                <div class="stat-card">

                    <div class="stat-top">

                        <span class="stat-label">
                            Total Collections
                        </span>

                        <div class="stat-icon">
                            📦
                        </div>

                    </div>

                    <div
                        class="stat-value"
                        id="totalCollections"
                    >
                        0
                    </div>

                    <div class="stat-change">
                        ↑ Ready to sync
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-top">

                        <span class="stat-label">
                            Verified Weight
                        </span>

                        <div class="stat-icon">
                            ⚖️
                        </div>

                    </div>

                    <div
                        class="stat-value"
                        id="totalWeight"
                    >
                        0 kg
                    </div>

                    <div class="stat-change">
                        ↑ Collected
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-top">

                        <span class="stat-label">
                            Reward Points
                        </span>

                        <div class="stat-icon">
                            ⭐
                        </div>

                    </div>

                    <div
                        class="stat-value"
                        id="rewardPoints"
                    >
                        0
                    </div>

                    <div class="stat-change">
                        Earned from verified waste
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-top">

                        <span class="stat-label">
                            Sync Status
                        </span>

                        <div class="stat-icon">
                            ☁️
                        </div>

                    </div>

                    <div
                        class="stat-value"
                        style="font-size:19px;"
                        id="syncStatus"
                    >
                        Ready
                    </div>

                    <div class="stat-change">
                        Offline-first enabled
                    </div>

                </div>

            </div>


            <div class="grid-2">


                <!-- COLLECTION FORM -->

                <div class="card">

                    <div class="card-header">

                        <div>

                            <div class="card-title">
                                New Collection
                            </div>

                            <div class="card-subtitle">
                                Record incoming e-waste
                            </div>

                        </div>

                        <span class="badge badge-green">
                            OFFLINE READY
                        </span>

                    </div>


                    <form id="collectionForm">


                        <div class="form-grid">


                            <div class="form-group">

                                <label>
                                    COLLECTOR ID
                                </label>

                                <input
                                    type="text"
                                    id="collectorId"
                                    placeholder="COL001"
                                    required
                                >

                            </div>


                            <div class="form-group">

                                <label>
                                    ITEM TYPE
                                </label>

                                <select
                                    id="itemType"
                                    required
                                >

                                    <option value="">
                                        Select item
                                    </option>

                                    <option>
                                        Laptop
                                    </option>

                                    <option>
                                        Mobile Phone
                                    </option>

                                    <option>
                                        Desktop
                                    </option>

                                    <option>
                                        Television
                                    </option>

                                    <option>
                                        Monitor
                                    </option>

                                    <option>
                                        Printer
                                    </option>

                                    <option>
                                        Refrigerator
                                    </option>

                                    <option>
                                        Other
                                    </option>

                                </select>

                            </div>


                            <div class="form-group">

                                <label>
                                    QUANTITY
                                </label>

                                <input
                                    type="number"
                                    id="quantity"
                                    min="1"
                                    placeholder="1"
                                    required
                                >

                            </div>


                            <div class="form-group">

                                <label>
                                    WEIGHT (KG)
                                </label>

                                <input
                                    type="number"
                                    id="weight"
                                    min="0.01"
                                    step="0.01"
                                    placeholder="2.50"
                                    required
                                >

                            </div>


                            <div class="form-group full">

                                <label>
                                    LOCATION
                                </label>

                                <div class="input-with-button">

                                    <input
                                        type="text"
                                        id="location"
                                        placeholder="GPS location"
                                        readonly
                                    >

                                    <button
                                        type="button"
                                        class="small-btn"
                                        onclick="getLocation()"
                                    >
                                        📍 Capture GPS
                                    </button>

                                </div>

                            </div>


                            <div class="form-group full">

                                <label>
                                    PHOTO VERIFICATION
                                </label>

                                <div class="photo-upload">

                                    <div class="photo-upload-icon">
                                        📸
                                    </div>

                                    <p>
                                        Capture evidence of the e-waste item
                                    </p>

                                    <label
                                        for="photo"
                                        class="file-btn"
                                    >
                                        Choose Photo
                                    </label>

                                    <input
                                        type="file"
                                        id="photo"
                                        accept="image/*"
                                        capture="environment"
                                    >

                                    <p id="photoName"
                                       style="margin-top:8px;">
                                    </p>

                                </div>

                            </div>

                        </div>


                        <button
                            type="submit"
                            class="submit-btn"
                        >
                            📤 Record Collection
                        </button>

                    </form>

                </div>


                <!-- ACTIVITY -->

                <div class="card">

                    <div class="card-header">

                        <div>

                            <div class="card-title">
                                Recent Activity
                            </div>

                            <div class="card-subtitle">
                                Latest collection events
                            </div>

                        </div>

                    </div>


                    <div id="activityList">

                        <div class="activity">

                            <div class="activity-icon">
                                📦
                            </div>

                            <div class="activity-text">

                                <strong>
                                    No collections yet
                                </strong>

                                <p>
                                    Your activity will appear here.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- COLLECTION TABLE -->

            <div class="card">

                <div class="card-header">

                    <div>

                        <div class="card-title">
                            Collection History
                        </div>

                        <div class="card-subtitle">
                            Track your submitted e-waste
                        </div>

                    </div>

                </div>


